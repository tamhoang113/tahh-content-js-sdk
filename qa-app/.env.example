# Required — Graph API
OPTIMIZELY_GRAPH_SINGLE_KEY=your-single-key
OPTIMIZELY_GRAPH_GATEWAY=https://staging.cg.optimizely.com/content/v2

# Required — CMS URL (for preview/edit mode)
OPTIMIZELY_CMS_URL=https://app.cms.optimizely.com

# Required — Application host (for URL matching)
APPLICATION_HOST=https://your-qa-app.vercel.app

# Required — CMS auth (for E2E tests)
CMS_SMOKE_USER=your-email@example.com
CMS_SMOKE_PASS=your-password

# Optional — HMAC auth (for auth tests)
OPTIMIZELY_GRAPH_APP_KEY=
OPTIMIZELY_GRAPH_SECRET=
