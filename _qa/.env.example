# CMS Site
CMS_URL=https://app-xxx.cmstest.optimizely.com
CMS_SMOKE_USER=cms.auto1+admin1@optimizely.com
CMS_SMOKE_PASS=your-password-here

# Content Graph
GRAPH_GATEWAY=https://staging.cg.optimizely.com
GRAPH_SINGLE_KEY=your-graph-key-here

# Fixture seeding (Integration API) — ROOT container GUID (e.g. your "Auto"
# container). Supply ONLY this one GUID; the fixture engine auto-creates a
# per-feature container under it (e.g. "CMS-56217 Taxonomy") and places test
# content there. Per-story override also supported, e.g.
# CMS_TEST_CONTAINER_CMS_56217.
CMS_TEST_CONTAINER=your-auto-root-container-guid

# Dev server (view mode tests)
BASE_URL=https://localhost:3001
